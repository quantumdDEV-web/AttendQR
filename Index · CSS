:root {
  --color-bg: #f6f7fb;
  --color-surface: #ffffff;
  --color-text: #1a1a2e;
  --color-muted: #667085;
  --color-primary: #4f46e5;
  --color-primary-dark: #4338ca;
  --color-good: #16a34a;
  --color-good-bg: #dcfce7;
  --color-warning: #b45309;
  --color-warning-bg: #fef3c7;
  --color-error: #dc2626;
  --color-error-bg: #fee2e2;
  --color-pending: #475569;
  --color-pending-bg: #e2e8f0;
  --radius: 12px;
  color-scheme: light;
}

* {
  box-sizing: border-box;
}

html,
body,
#root {
  height: 100%;
}

body {
  margin: 0;
  font-family: 'Segoe UI', system-ui, -apple-system, Roboto, Helvetica, Arial, sans-serif;
  background: var(--color-bg);
  color: var(--color-text);
  -webkit-font-smoothing: antialiased;
}

.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24px 16px 48px;
}

.hero {
  text-align: center;
  padding: 56px 16px 32px;
  max-width: 640px;
}

.hero__title {
  margin: 0;
  font-size: clamp(2.25rem, 6vw, 3rem);
  font-weight: 800;
  color: var(--color-primary);
  letter-spacing: -0.02em;
}

.hero__subtitle {
  margin: 8px 0 0;
  font-size: 1.125rem;
  font-weight: 600;
  color: var(--color-text);
}

.hero__tagline {
  margin: 8px 0 0;
  font-size: 1rem;
  color: var(--color-muted);
}

.config-warning {
  width: 100%;
  max-width: 640px;
  background: var(--color-warning-bg);
  border: 1px solid #fbbf24;
  color: #78350f;
  border-radius: var(--radius);
  padding: 16px 20px;
  margin-bottom: 24px;
}

.config-warning strong {
  display: block;
  margin-bottom: 4px;
}

.config-warning p {
  margin: 0;
  font-size: 0.9rem;
  line-height: 1.5;
}

.config-warning code {
  background: rgba(0, 0, 0, 0.08);
  padding: 2px 6px;
  border-radius: 4px;
  font-size: 0.85em;
}

.status-panel {
  width: 100%;
  max-width: 640px;
  display: flex;
  flex-direction: column;
  gap: 12px;
  background: var(--color-surface);
  border-radius: var(--radius);
  padding: 20px;
  box-shadow: 0 1px 3px rgba(16, 24, 40, 0.06), 0 1px 2px rgba(16, 24, 40, 0.04);
}

.status-badge {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  padding: 10px 12px;
  border-radius: 8px;
}

.status-badge--good {
  background: var(--color-good-bg);
}
.status-badge--warning {
  background: var(--color-warning-bg);
}
.status-badge--error {
  background: var(--color-error-bg);
}
.status-badge--pending {
  background: var(--color-pending-bg);
}

.status-dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  margin-top: 5px;
  flex-shrink: 0;
}

.status-dot--good {
  background: var(--color-good);
}
.status-dot--warning {
  background: var(--color-warning);
}
.status-dot--error {
  background: var(--color-error);
}
.status-dot--pending {
  background: var(--color-pending);
}

.status-badge__text {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.status-badge__label {
  font-weight: 700;
  font-size: 0.95rem;
}

.status-badge__detail {
  font-size: 0.85rem;
  color: var(--color-muted);
}

.placeholder-note {
  width: 100%;
  max-width: 640px;
  margin-top: 24px;
  text-align: center;
}

.placeholder-note p {
  color: var(--color-muted);
  font-size: 0.9rem;
  line-height: 1.6;
}

@media (max-width: 480px) {
  .hero {
    padding: 40px 12px 24px;
  }
}
